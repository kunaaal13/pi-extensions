{
  "name": "pi-ui-kit",
  "version": "0.1.0",
  "description": "Extensible Claude Code-style UI toolkit for the pi coding agent: pluggable tool renderers, any shiki theme (bundled, npm, or JSON file), layered diff palettes",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "tool-renderer",
    "shiki",
    "diff",
    "claude-code",
    "theme"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
    "src",
    "themes",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "themes": [
      "./themes/pierre-dark.json",
      "./themes/pierre-light.json"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "shiki": "^4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@pierre/theme": "^2.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
